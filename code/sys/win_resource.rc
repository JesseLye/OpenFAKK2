/////////////////////////////////////////////////////////////////////////////
//
// Version
//

// Windows names the program by FileDescription (taskbar, Task Manager,
// volume mixer), so without this block it falls back to stale names.
#ifndef WINDOWS_PRODUCT_NAME
#define WINDOWS_PRODUCT_NAME "openfakk2"
#endif
#ifndef PRODUCT_VERSION
#define PRODUCT_VERSION "0.1"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,0,0,0
 PRODUCTVERSION 0,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", WINDOWS_PRODUCT_NAME
            VALUE "FileVersion", PRODUCT_VERSION
            VALUE "InternalName", WINDOWS_PRODUCT_NAME
            VALUE "ProductName", WINDOWS_PRODUCT_NAME
            VALUE "ProductVersion", PRODUCT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END


