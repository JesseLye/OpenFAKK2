// the picture
resource
Label
{
name "Default"
title "Anti-Aliasing"
rect 52 36 184 16
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
shader "textures/menu/text_back"
}
resource
Label
{
name "Default"
rect 52 52 184 16
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
linkcvar "r_ext_multisample"
shader "textures/menu/blank2"
linkstring 0 "Off"
linkstring 2 "2x"
linkstring 4 "4x"
linkstring 8 "8x"
}
resource
PulldownMenuContainer
{
title "list"
name "list"
rect 38 52 16 16
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
menushader "MENU" "textures/menu/pulldownarrow"
selmenushader "MENU" "textures/menu/pulldownarrow_sel"
addpopup "MENU" "Off" command "set r_ext_multisample 0"
addpopup "MENU" "2x" command "set r_ext_multisample 2"
addpopup "MENU" "4x" command "set r_ext_multisample 4"
addpopup "MENU" "8x" command "set r_ext_multisample 8"
}
resource
Label
{
name "Default"
title "Anisotropic Filtering"
rect 52 76 184 16
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
shader "textures/menu/text_back"
}
resource
Label
{
name "Default"
