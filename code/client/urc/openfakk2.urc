{
name "Default"
rect 12 378 256 64
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
stuffcommand "ui_checkrestart; popmenu 0"
shader "textures/menu/B_apply"
hovershader "textures/menu/B_apply_selected"
clicksound sound/misc/menu/select.wav
ordernumber 3
}
resource
Button
{
name "Default"
rect 372 378 256 64
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "RAISED"
stuffcommand "ui_resetcvars"
shader "textures/menu/b_default"
hovershader "textures/menu/b_default_selected"
