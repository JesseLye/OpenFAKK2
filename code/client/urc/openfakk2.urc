// OpenFAKK2's options: the settings OpenFAKK2 adds to the game, laid out as
// Ritual's advanced options menu. Built into the engine (cmake/client.cmake);
// a ui/*.urc with a menu of the same name takes its place. A label's
// "linkformat" (OpenFAKK2's, cl_urc.c) puts its value into its text.
menu "openfakk2" 640 480 NONE 0.5
fullscreen 1
bgcolor 1 1 1 1
borderstyle NONE
bgfill 0 0 0 1
fadein 0.5

include "ui/common.inc"

resource
Label
{
name "Default"
rect 32 32 576 336
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
shader "textures/menu/adv_back"
}
