PulldownMenuContainer
{
title "list"
name "list"
rect 38 132 16 16
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
menushader "MENU" "textures/menu/pulldownarrow"
selmenushader "MENU" "textures/menu/pulldownarrow_sel"
addpopup "MENU" "60" command "set com_maxfps 60"
addpopup "MENU" "85" command "set com_maxfps 85"
addpopup "MENU" "120" command "set com_maxfps 120"
addpopup "MENU" "144" command "set com_maxfps 144"
addpopup "MENU" "165" command "set com_maxfps 165"
addpopup "MENU" "240" command "set com_maxfps 240"
addpopup "MENU" "None" command "set com_maxfps 0"
}
