fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
linkcvar "ui_anisotropy"
shader "textures/menu/blank2"
}
resource
PulldownMenuContainer
{
title "list"
name "list"
rect 38 92 16 16
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
menushader "MENU" "textures/menu/pulldownarrow"
selmenushader "MENU" "textures/menu/pulldownarrow_sel"
addpopup "MENU" "Off" command "set r_ext_texture_filter_anisotropic 0"
addpopup "MENU" "2x" command "set r_ext_texture_filter_anisotropic 1; set r_ext_max_anisotropy 2"
addpopup "MENU" "4x" command "set r_ext_texture_filter_anisotropic 1; set r_ext_max_anisotropy 4"
addpopup "MENU" "8x" command "set r_ext_texture_filter_anisotropic 1; set r_ext_max_anisotropy 8"
addpopup "MENU" "16x" command "set r_ext_texture_filter_anisotropic 1; set r_ext_max_anisotropy 16"
}
