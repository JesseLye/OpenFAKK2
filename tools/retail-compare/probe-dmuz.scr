// Records the suite's muzzle flash demo (demos/probe-dmuz.dm3), probe-muzzle's scene: on
// zoo, tools/retail-compare/fx/test_muzzle.tik (the flash sprite and model held still)
// ahead of Julie, then the uzi fired in bursts through two cameras close to her right
// hand, one beside the barrel and one ahead of it. The "demo-muzzle" check plays it at 20
// frames a second, so every flash (0.05 s) is in the same frames on both games; made on
// retail by refresh-retail.ps1. record needs g_syncronousClients (fakk2.exe 0x4201f6).
probe:
waitforplayer
wait 2
spawn test_muzzle.tik origin "-2150 1568 160" targetname "fxmuz"
wait 0.1
$fxmuz anim idle
spawn Camera targetname "camside" origin "-2310 1480 50" angles "5 90 0"
spawn Camera targetname "camfront" origin "-2250 1530 55" angles "5 160 0"
stuffcmd "give weapon_uzi.tik"
wait 0.5
stuffcmd "use Uzi right"
stuffcmd "set g_syncronousClients 1"
wait 3
stuffcmd "record probe-dmuz"
wait 1
cuecamera $camside
wait 1
stuffcmd "+attackright"
wait 0.8
stuffcmd "-attackright"
wait 0.5
cuecamera $camfront
wait 1
stuffcmd "+attackright"
wait 0.8
stuffcmd "-attackright"
wait 0.5
stuffcmd "stoprecord"
wait 0.2
stuffcmd "quit"
end
