// The dark creeper patrolling example/patrol's two path nodes (the map's own script), read
// twice on its way, then killed (its death and the thread on it), then removed.
// compare-player.ps1 -Map example/patrol -Probe probe-xpatrol; save-load.ps1 -Map example/patrol -Probe probe-xpatrol -Thread save

probe:
waitforplayer
wait 2
stuffcmd "echo ==== patrol 2s"
stuffcmd "whatis 0"
