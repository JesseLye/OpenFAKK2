stuffcmd "whatis 15"
stuffcmd "whatis 16"
stuffcmd "whatis 17"
stuffcmd "whatis 18"
stuffcmd "whatis 19"
stuffcmd "whatis 20"
stuffcmd "whatis 21"
stuffcmd "whatis 22"
stuffcmd "whatis 23"
stuffcmd "whatis 24"
stuffcmd "whatis 25"
stuffcmd "whatis 26"
stuffcmd "whatis 27"
stuffcmd "whatis 28"
stuffcmd "whatis 29"
stuffcmd "whatis 30"
stuffcmd "whatis 31"
wait 0.5
stuffcmd "levelvars"
stuffcmd "pendingevents"
end

save:
waitforplayer
wait 2
$dude walkto $dude_dest
wait 0.5
$dude remove
wait 0.5
stuffcmd "savegame probesave"
wait 2
stuffcmd "echo ==== removed"
