stuffcmd "whatis 15"
stuffcmd "whatis 16"
stuffcmd "whatis 17"
stuffcmd "whatis 18"
stuffcmd "whatis 19"
stuffcmd "whatis 20"
stuffcmd "whatis 21"
stuffcmd "whatis 22"
stuffcmd "whatis 23"
stuffcmd "whatis 24"
stuffcmd "whatis 25"
stuffcmd "whatis 26"
stuffcmd "whatis 27"
stuffcmd "whatis 28"
stuffcmd "whatis 29"
stuffcmd "whatis 30"
stuffcmd "whatis 31"
wait 0.5
wait 2
stuffcmd "echo ==== later"
stuffcmd "whatis 0"
stuffcmd "whatis 1"
stuffcmd "whatis 2"
stuffcmd "whatis 3"
stuffcmd "whatis 4"
stuffcmd "whatis 5"
stuffcmd "whatis 6"
stuffcmd "whatis 7"
stuffcmd "whatis 8"
stuffcmd "whatis 9"
stuffcmd "whatis 10"
stuffcmd "whatis 11"
stuffcmd "whatis 12"
stuffcmd "whatis 13"
