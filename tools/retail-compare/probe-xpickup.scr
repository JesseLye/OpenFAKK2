// Balthazar picking example/pickup's Shgliek up, carrying it to the path node and throwing
// it (the map's use-trigger thread, run from here): an actor holding another entity.
// compare-player.ps1 -Map example/pickup -Probe probe-xpickup; save-load.ps1 -Map example/pickup -Probe probe-xpickup -Thread save

probe:
waitforplayer
wait 2
stuffcmd "echo ==== before"
stuffcmd "whatis 0"
stuffcmd "whatis 1"
stuffcmd "whatis 2"
stuffcmd "whatis 3"
stuffcmd "whatis 4"
stuffcmd "whatis 5"
