probe:
waitforplayer
wait 25
stuffcmd "give weapon_sword.tik"
stuffcmd "give weapon_uzi.tik"
stuffcmd "give weapon_smallshield.tik"
stuffcmd "give weapon_cbow.tik"
stuffcmd "give weapon_chainsword.tik"
wait 1
stuffcmd "warpinv swords"
wait .5
stuffcmd "screenshot"
wait 1
stuffcmd "warpinv guns"
wait .5
stuffcmd "screenshot"
wait 1
stuffcmd "use GreenSword righthand"
wait 1
stuffcmd "use Smallshield lefthand"
wait 2
stuffcmd "screenshot"
wait 1
stuffcmd "inventory"
wait 1
stuffcmd "screenshot"
wait 1
stuffcmd "quit"
end
