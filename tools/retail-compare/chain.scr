// The level chain: an automated playthrough of the whole game by gamemap, the way the
// game moves from one level to the next (trigger_changelevel and the cinematics' exits,
// with the side trips to training, landersroost, fog, water and blood). Started on intro
// with "+map intro +script thread chain.scr::s0" by tools\suite\level-chain.ps1, on the
// real client (gamemap autosaves only when the server is not dedicated), retail's or ours.
// Each step waits four seconds of level time (the autosave comes at 1.75 s), prints a
// "==== chain" marker, the inventory and the player, and then queues the next level and
// this script's thread for it: gamemap spawns the level before the next command runs, so
// the thread starts on the new level, as "+script thread" does on the command line. The
// player is given a few weapons on fakkhouse, so the inventory has something to carry.
// Only the first step uses waitforplayer: on under, whose intro sets the player's model,
// a waitforplayer started by the previous level's gamemap never returned, on the retail
// game as on ours.
// Order and spawn spots come from the maps' trigger_changelevel entities and the
// *_cinemas.scr scripts.

s0:
waitforplayer
wait 4
stuffcmd "echo ==== chain s0 intro"
stuffcmd "listinventory"
stuffcmd "whatis 0"
stuffcmd "gamemap fakkhouse"
stuffcmd "script thread chain.scr::s1"
end

s1:
wait 4
stuffcmd "give weapon_sword.tik"
stuffcmd "give weapon_uzi.tik"
stuffcmd "give weapon_shotgun.tik"
stuffcmd "give weapon_cbow.tik"
wait 1
stuffcmd "echo ==== chain s1 fakkhouse"
stuffcmd "listinventory"
stuffcmd "whatis 0"
stuffcmd "gamemap training$spawn_fakkhouse"
stuffcmd "script thread chain.scr::s2"
end

s2:
wait 4
stuffcmd "echo ==== chain s2 training$spawn_fakkhouse"
stuffcmd "listinventory"
stuffcmd "whatis 0"
stuffcmd "gamemap fakkhouse$spawn_training"
stuffcmd "script thread chain.scr::s3"
end

s3:
wait 4
stuffcmd "echo ==== chain s3 fakkhouse$spawn_training"
stuffcmd "listinventory"
stuffcmd "whatis 0"
stuffcmd "gamemap homes1$spawn_fakkhouse"
stuffcmd "script thread chain.scr::s4"
end

s4:
wait 4
stuffcmd "echo ==== chain s4 homes1$spawn_fakkhouse"
stuffcmd "listinventory"
stuffcmd "whatis 0"
stuffcmd "gamemap landersroost$spawn_homes1"
stuffcmd "script thread chain.scr::s5"
end

s5:
